<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>D'oh! | The Unofficial Homer J. Simpson Fan Page</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --plant-navy:#1b2430;
    --plant-navy-2:#242f40;
    --core-green:#8fd400;
    --core-green-dim:#5c8f00;
    --duff-yellow:#ffcc29;
    --skin-yellow:#fdd835;
    --donut-pink:#ff7aa8;
    --donut-glaze:#ffe8f1;
    --cream:#fff8e6;
    --ink:#20241b;
    --warn:#ff5a4e;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--cream);
    color:var(--ink);
    font-family:'Space Grotesk', sans-serif;
    line-height:1.5;
  }
  h1,h2,h3,.display{
    font-family:'Baloo 2', sans-serif;
    margin:0;
  }
  img,svg{display:block;max-width:100%;}
  a{color:inherit;}

  /* ---------- Radiation stripe top bar ---------- */
  .hazard-bar{
    height:10px;
    background:repeating-linear-gradient(
      -45deg,
      var(--duff-yellow),
      var(--duff-yellow) 16px,
      var(--ink) 16px,
      var(--ink) 32px
    );
  }

  .wrap{max-width:1080px;margin:0 auto;padding:0 24px;}

  /* ---------- HERO ---------- */
  .hero{
    background:
      radial-gradient(circle at 80% 10%, rgba(143,212,0,0.15), transparent 45%),
      var(--plant-navy);
    color:var(--cream);
    padding:64px 0 48px;
    position:relative;
    overflow:hidden;
  }
  .hero .wrap{
    display:grid;
    grid-template-columns:1.1fr 1fr;
    gap:40px;
    align-items:center;
  }
  .eyebrow{
    display:inline-flex;
    align-items:center;
    gap:8px;
    font-size:0.75rem;
    letter-spacing:0.14em;
    text-transform:uppercase;
    background:rgba(143,212,0,0.12);
    color:var(--core-green);
    border:1px solid rgba(143,212,0,0.4);
    padding:6px 12px;
    border-radius:999px;
    font-weight:600;
  }
  .eyebrow .dot{
    width:8px;height:8px;border-radius:50%;
    background:var(--core-green);
    box-shadow:0 0 8px var(--core-green);
  }
  .hero h1{
    font-size:clamp(2.6rem, 5vw, 4.2rem);
    color:var(--duff-yellow);
    margin:16px 0 4px;
    line-height:1.02;
    text-shadow:3px 3px 0 rgba(0,0,0,0.35);
  }
  .hero .subtitle{
    font-size:1.15rem;
    color:var(--donut-glaze);
    opacity:0.9;
    margin-bottom:20px;
  }
  .badge-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px;}
  .badge{
    font-size:0.8rem;
    font-weight:600;
    background:var(--plant-navy-2);
    border:1px solid rgba(255,255,255,0.15);
    padding:6px 12px;
    border-radius:8px;
    color:var(--cream);
  }

  /* ---------- Homer avatar (original CSS illustration) ---------- */
  .avatar-stage{
    display:flex;
    justify-content:center;
    align-items:center;
  }
  .avatar-ring{
    width:300px;height:300px;
    border-radius:50%;
    background:conic-gradient(from 90deg, var(--core-green), var(--duff-yellow), var(--donut-pink), var(--core-green));
    display:flex;align-items:center;justify-content:center;
    padding:8px;
    animation:spin-slow 14s linear infinite;
    filter:drop-shadow(0 10px 30px rgba(0,0,0,0.45));
  }
  @keyframes spin-slow{to{transform:rotate(360deg);}}
  .avatar-inner{
    width:100%;height:100%;
    border-radius:50%;
    background:var(--plant-navy);
    display:flex;align-items:center;justify-content:center;
    animation:spin-slow-reverse 14s linear infinite;
  }
  @keyframes spin-slow-reverse{to{transform:rotate(-360deg);}}

  .toon-head{width:220px;height:220px;}

  /* ---------- MAIN SECTIONS ---------- */
  section{padding:56px 0;}
  .section-label{
    font-size:0.78rem;
    text-transform:uppercase;
    letter-spacing:0.14em;
    font-weight:700;
    color:var(--core-green-dim);
    margin-bottom:8px;
  }
  .section-title{font-size:2rem;margin-bottom:20px;color:var(--ink);}

  .bio{
    background:var(--donut-glaze);
    border-radius:24px;
    padding:36px;
    border:2px dashed var(--donut-pink);
  }
  .bio p{max-width:70ch;font-size:1.05rem;}
  .bio strong{color:#c23b6b;}

  /* ---------- FACTS ---------- */
  .facts-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(230px,1fr));
    gap:18px;
  }
  .fact-card{
    background:var(--plant-navy);
    color:var(--cream);
    border-radius:18px;
    padding:22px;
    position:relative;
    overflow:hidden;
    border-top:5px solid var(--core-green);
  }
  .fact-card .num{
    font-family:'Baloo 2';
    font-size:2.4rem;
    color:rgba(143,212,0,0.35);
    position:absolute;
    top:8px;right:16px;
  }
  .fact-card h3{
    font-size:1.05rem;
    color:var(--duff-yellow);
    margin-bottom:8px;
    position:relative;
  }
  .fact-card p{margin:0;font-size:0.92rem;color:var(--donut-glaze);position:relative;}

  /* ---------- FUN FACT GENERATOR (Homer-o-Meter) ---------- */
  .meter-panel{
    background:var(--plant-navy);
    border-radius:24px;
    padding:40px;
    color:var(--cream);
    display:grid;
    grid-template-columns:220px 1fr;
    gap:36px;
    align-items:center;
  }
  .gauge{
    position:relative;
    width:200px;height:200px;
    border-radius:50%;
    background:
      radial-gradient(circle at center, var(--plant-navy) 58%, transparent 59%),
      conic-gradient(var(--core-green) 0deg, var(--duff-yellow) 120deg, var(--warn) 240deg, var(--core-green) 360deg);
    display:flex;align-items:center;justify-content:center;
    box-shadow:inset 0 0 0 6px rgba(255,255,255,0.06);
  }
  .gauge::before{
    content:"";
    position:absolute;
    width:6px;height:78px;
    background:var(--cream);
    top:22px;left:50%;
    transform-origin:bottom center;
    transform:translateX(-50%) rotate(0deg);
    border-radius:4px;
    transition:transform 0.6s cubic-bezier(.34,1.56,.64,1);
  }
  .gauge.spin::before{transform:translateX(-50%) rotate(340deg);}
  .gauge .cap{
    width:22px;height:22px;border-radius:50%;
    background:var(--duff-yellow);
    z-index:2;
    box-shadow:0 0 0 4px var(--plant-navy);
  }

  .meter-text h3{color:var(--duff-yellow);font-size:1.4rem;margin-bottom:10px;}
  #fact-output{
    background:var(--plant-navy-2);
    border-left:4px solid var(--core-green);
    border-radius:10px;
    padding:16px 18px;
    min-height:64px;
    font-size:1.02rem;
    margin-bottom:18px;
  }
  .btn{
    font-family:'Baloo 2';
    font-weight:700;
    font-size:1rem;
    background:var(--duff-yellow);
    color:var(--ink);
    border:none;
    padding:14px 26px;
    border-radius:14px;
    cursor:pointer;
    box-shadow:0 6px 0 #b78a00;
    transition:transform 0.08s ease, box-shadow 0.08s ease;
  }
  .btn:hover{filter:brightness(1.04);}
  .btn:active{transform:translateY(6px);box-shadow:0 0 0 #b78a00;}
  .btn.secondary{
    background:var(--donut-pink);
    box-shadow:0 6px 0 #b23e69;
    margin-left:10px;
  }
  .btn.secondary:active{box-shadow:0 0 0 #b23e69;}
  .btn:focus-visible, .quiz-option:focus-visible, .btn.secondary:focus-visible{
    outline:3px solid var(--core-green);
    outline-offset:2px;
  }

  /* ---------- QUIZ ---------- */
  .quiz-panel{
    background:var(--donut-glaze);
    border-radius:24px;
    padding:36px;
  }
  .quiz-progress{
    font-size:0.85rem;
    font-weight:600;
    color:#c23b6b;
    margin-bottom:10px;
  }
  #quiz-question{font-size:1.2rem;margin-bottom:18px;}
  .quiz-options{display:grid;gap:10px;margin-bottom:18px;}
  .quiz-option{
    text-align:left;
    background:#fff;
    border:2px solid #ffd2e2;
    border-radius:12px;
    padding:12px 16px;
    font-family:'Space Grotesk';
    font-size:0.98rem;
    cursor:pointer;
    transition:background 0.15s, border-color 0.15s, transform 0.05s;
  }
  .quiz-option:hover{border-color:var(--donut-pink);}
  .quiz-option.correct{background:#e4ffd6;border-color:var(--core-green-dim);}
  .quiz-option.wrong{background:#ffe1de;border-color:var(--warn);}
  .quiz-option[disabled]{cursor:default;}
  #quiz-feedback{min-height:24px;font-weight:600;margin-bottom:14px;}
  #quiz-result{font-size:1.1rem;font-weight:700;}

  footer{
    background:var(--ink);
    color:var(--donut-glaze);
    text-align:center;
    padding:28px 20px;
    font-size:0.85rem;
  }
  footer a{color:var(--duff-yellow);}

  @media (max-width:760px){
    .hero .wrap{grid-template-columns:1fr;text-align:center;}
    .avatar-stage{order:-1;}
    .badge-row{justify-content:center;}
    .meter-panel{grid-template-columns:1fr;text-align:center;}
    .gauge{margin:0 auto;}
  }

  @media (prefers-reduced-motion: reduce){
    .avatar-ring, .avatar-inner{animation:none;}
    .gauge::before{transition:none;}
  }
</style>
</head>
<body>

<div class="hazard-bar"></div>

<!-- ================= HERO ================= -->
<header class="hero">
  <div class="wrap">
    <div>
      <span class="eyebrow"><span class="dot"></span> Sector 7G &middot; Unofficial Fan Page</span>
      <h1>Homer J. Simpson</h1>
      <p class="subtitle">Safety Inspector. Snack enthusiast. Springfield's most lovable disaster.</p>
      <div class="badge-row">
        <span class="badge">🍩 Donut Connoisseur</span>
        <span class="badge">☢️ Sector 7G</span>
        <span class="badge">🛋️ Couch Strategist</span>
        <span class="badge">🎳 Pin Pal Legend</span>
      </div>
    </div>
    <div class="avatar-stage">
      <div class="avatar-ring">
        <div class="avatar-inner">
          <!-- Original stylized fan-art avatar, not a reproduction of any copyrighted artwork -->
          <svg class="toon-head" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <ellipse cx="100" cy="115" rx="78" ry="70" fill="#fdd835"/>
            <path d="M25 110 Q100 25 175 110" fill="none" stroke="#3a2c00" stroke-width="6" stroke-linecap="round"/>
            <path d="M40 78 Q46 68 56 76" fill="none" stroke="#3a2c00" stroke-width="5" stroke-linecap="round"/>
            <ellipse cx="72" cy="100" rx="16" ry="20" fill="#fff"/>
            <ellipse cx="112" cy="100" rx="16" ry="20" fill="#fff"/>
            <circle cx="76" cy="106" r="6" fill="#3a2c00"/>
            <circle cx="116" cy="106" r="6" fill="#3a2c00"/>
            <path d="M60 92 Q72 84 84 92" fill="none" stroke="#3a2c00" stroke-width="4" stroke-linecap="round"/>
            <ellipse cx="100" cy="128" rx="14" ry="12" fill="#fdd835" stroke="#e0ad00" stroke-width="2"/>
            <path d="M55 150 Q100 185 150 148" fill="none" stroke="#3a2c00" stroke-width="6" stroke-linecap="round"/>
            <path d="M35 135 Q20 140 25 155" fill="none" stroke="#3a2c00" stroke-width="5" stroke-linecap="round"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</header>

<main class="wrap">

  <!-- ================= BIO ================= -->
  <section id="bio">
    <div class="section-label">Who is this guy?</div>
    <h2 class="section-title">The Legend of 742 Evergreen Terrace</h2>
    <div class="bio">
      <p>
        Homer Simpson has spent decades keeping Springfield's nuclear power plant
        <em>almost</em> safe as its famously distracted Safety Inspector. When he's not
        dozing at his console, you'll find him chasing the perfect donut, bowling with
        the Pin Pals, or hugging Bart just a little too hard around the neck.
      </p>
      <p>
        Beneath the bald head and the endless snack cravings is a guy who, somehow,
        against all odds, always shows up for his family &mdash; <strong>Marge, Bart, Lisa, and Maggie</strong>
        &mdash; even after the most chaotic Tuesday imaginable.
      </p>
    </div>
  </section>

  <!-- ================= FACTS ================= -->
  <section id="facts">
    <div class="section-label">Trivia Vault</div>
    <h2 class="section-title">A Few Interesting Facts</h2>
    <div class="facts-grid">
      <div class="fact-card">
        <span class="num">01</span>
        <h3>Signature Sound</h3>
        <p>His frustrated groan became so iconic it's been added to real-world dictionaries as a recognized exclamation of dismay.</p>
      </div>
      <div class="fact-card">
        <span class="num">02</span>
        <h3>Job Title</h3>
        <p>Officially the Safety Inspector at Sector 7G of the Springfield Nuclear Power Plant &mdash; a title he treats very loosely.</p>
      </div>
      <div class="fact-card">
        <span class="num">03</span>
        <h3>Bowling Alter Ego</h3>
        <p>Under the name "Pin Pal," he's a surprisingly skilled bowler whenever the plot calls for a perfect game.</p>
      </div>
      <div class="fact-card">
        <span class="num">04</span>
        <h3>Snack Loyalty</h3>
        <p>Donuts are his ride-or-die snack, though he's never once turned down a pork chop, a beer, or a mystery leftover.</p>
      </div>
    </div>
  </section>

  <!-- ================= FUN FACT GENERATOR ================= -->
  <section id="generator">
    <div class="section-label">Interactive &middot; Feature 1</div>
    <h2 class="section-title">The Homer-O-Meter</h2>
    <div class="meter-panel">
      <div class="gauge" id="gauge">
        <div class="cap"></div>
      </div>
      <div class="meter-text">
        <h3>Spin it for a random Homer moment</h3>
        <div id="fact-output">Press the button &mdash; the needle knows things.</div>
        <button class="btn" id="spin-btn">Spin the Meter</button>
      </div>
    </div>
  </section>

  <!-- ================= QUIZ ================= -->
  <section id="quiz">
    <div class="section-label">Interactive &middot; Feature 2</div>
    <h2 class="section-title">How Well Do You Know Homer?</h2>
    <div class="quiz-panel">
      <div class="quiz-progress" id="quiz-progress">Question 1 of 5</div>
      <div id="quiz-question"></div>
      <div class="quiz-options" id="quiz-options"></div>
      <div id="quiz-feedback"></div>
      <div id="quiz-result"></div>
      <button class="btn secondary" id="quiz-restart" style="display:none;">Play Again</button>
    </div>
  </section>

</main>

<footer>
  <p>Made with 🍩 by a fan. Homer Simpson and related characters belong to their respective creators &mdash; this page is an unofficial, non-commercial tribute.</p>
</footer>

<script>
  /* ---------------- Fun Fact Generator ---------------- */
  const facts = [
    "Homer once tried to prove he could gain enough weight to qualify for disability leave &mdash; and ate his way to a 3XL life.",
    "He named his boat 'The Homer' after founding a hit-or-miss offshore lobster business.",
    "Homer has held (and lost) more side jobs than most people apply to in a lifetime.",
    "His go-to stress relief move is choking Bart, which somehow never ends the sitcom.",
    "He once became an internet sensation just for dancing at his own wedding-adjacent chaos.",
    "Homer's blood alcohol tolerance for Duff Beer is treated as a Springfield natural resource.",
    "He's been an astronaut, a boxer, a food critic, and a garbage commissioner &mdash; all before lunch, relatively speaking.",
    "His favorite chair has a permanent butt-shaped groove that the family calls a load-bearing feature.",
    "Homer's snoring has reportedly been mistaken for plant machinery malfunctioning.",
    "He believes any problem can be solved by a donut, a nap, or turning the TV up louder."
  ];

  const gauge = document.getElementById('gauge');
  const output = document.getElementById('fact-output');
  const spinBtn = document.getElementById('spin-btn');
  let lastIndex = -1;

  spinBtn.addEventListener('click', () => {
    gauge.classList.remove('spin');
    void gauge.offsetWidth; // restart animation
    gauge.classList.add('spin');

    let idx = Math.floor(Math.random() * facts.length);
    if (idx === lastIndex) idx = (idx + 1) % facts.length;
    lastIndex = idx;

    output.style.opacity = 0;
    setTimeout(() => {
      output.innerHTML = facts[idx];
      output.style.opacity = 1;
    }, 250);
  });
  output.style.transition = 'opacity 0.25s ease';

  /* ---------------- Quiz ---------------- */
  const questions = [
    {
      q: "What is Homer's job title at the power plant?",
      options: ["Safety Inspector", "Chief Engineer", "Head of HR", "Janitor"],
      correct: 0
    },
    {
      q: "What is the name of Homer's bowling team persona?",
      options: ["The Strike Master", "Pin Pal", "Alley Cat", "Gutter Boy"],
      correct: 1
    },
    {
      q: "Which snack is most associated with Homer?",
      options: ["Pretzels", "Popcorn", "Donuts", "Chips"],
      correct: 2
    },
    {
      q: "How many children does Homer have?",
      options: ["Two", "Three", "Four", "One"],
      correct: 1
    },
    {
      q: "What sound does Homer famously make when frustrated?",
      options: ["Ugh!", "D'oh!", "Argh!", "Bah!"],
      correct: 1
    }
  ];

  let current = 0;
  let score = 0;

  const qEl = document.getElementById('quiz-question');
  const optsEl = document.getElementById('quiz-options');
  const feedbackEl = document.getElementById('quiz-feedback');
  const progressEl = document.getElementById('quiz-progress');
  const resultEl = document.getElementById('quiz-result');
  const restartBtn = document.getElementById('quiz-restart');

  function renderQuestion(){
    feedbackEl.textContent = '';
    resultEl.textContent = '';
    const item = questions[current];
    progressEl.textContent = `Question ${current + 1} of ${questions.length}`;
    qEl.textContent = item.q;
    optsEl.innerHTML = '';

    item.options.forEach((opt, i) => {
      const btn = document.createElement('button');
      btn.className = 'quiz-option';
      btn.textContent = opt;
      btn.addEventListener('click', () => handleAnswer(i, btn));
      optsEl.appendChild(btn);
    });
  }

  function handleAnswer(i, btn){
    const item = questions[current];
    const allBtns = optsEl.querySelectorAll('.quiz-option');
    allBtns.forEach(b => b.disabled = true);

    if (i === item.correct){
      btn.classList.add('correct');
      feedbackEl.textContent = "Correct! Nailed it.";
      feedbackEl.style.color = 'var(--core-green-dim)';
      score++;
    } else {
      btn.classList.add('wrong');
      allBtns[item.correct].classList.add('correct');
      feedbackEl.textContent = "Not quite &mdash; the highlighted answer was correct.";
      feedbackEl.style.color = 'var(--warn)';
    }

    setTimeout(() => {
      current++;
      if (current < questions.length){
        renderQuestion();
      } else {
        finishQuiz();
      }
    }, 1100);
  }

  function finishQuiz(){
    qEl.textContent = '';
    optsEl.innerHTML = '';
    feedbackEl.textContent = '';
    progressEl.textContent = 'Quiz complete';
    resultEl.textContent = `You scored ${score} out of ${questions.length}.`;
    restartBtn.style.display = 'inline-block';
  }

  restartBtn.addEventListener('click', () => {
    current = 0;
    score = 0;
    restartBtn.style.display = 'none';
    renderQuestion();
  });

  renderQuestion();
</script>

</body>
</html>
